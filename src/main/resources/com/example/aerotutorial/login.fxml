<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.aerotutorial.LoginController" style="-fx-padding: 20;">
    <Label text="🌍 AeroSafe Login" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <VBox spacing="8" alignment="CENTER" style="-fx-padding: 10;">
        <Label text="Select Your Role:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <ComboBox fx:id="roleComboBox" promptText="Choose Role" prefWidth="250" style="-fx-font-size: 13px;"/>
    </VBox>

    <TextField fx:id="usernameField" promptText="Username or Email" prefWidth="250" style="-fx-font-size: 13px; -fx-padding: 8;"/>

    <!-- Password field with visibility toggle -->
    <StackPane prefWidth="250">
        <PasswordField fx:id="passwordField" promptText="Password" prefWidth="250" style="-fx-font-size: 13px; -fx-padding: 8;"/>
        <TextField fx:id="passwordTextField" promptText="Password" prefWidth="250" visible="false" managed="false" style="-fx-font-size: 13px; -fx-padding: 8;"/>
        <Button fx:id="togglePasswordBtn" text="👁" onAction="#togglePasswordVisibility"
                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 16px;"
                StackPane.alignment="CENTER_RIGHT" prefWidth="30" prefHeight="30"/>
    </StackPane>

    <Hyperlink text="Forgot Password?" onAction="#handleForgotPassword" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px; -fx-cursor: hand;"/>

    <Button text="Login" onAction="#handleLogin" prefWidth="250" style="-fx-font-size: 14px; -fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;"/>
    <Button text="Sign Up" onAction="#switchToSignup" prefWidth="250" style="-fx-font-size: 14px; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;"/>

    <Label fx:id="messageLabel" style="-fx-text-fill: red; -fx-font-size: 13px; -fx-font-weight: bold;"/>
</VBox>